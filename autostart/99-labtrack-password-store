# Installed at /etc/chromium.d/99-labtrack-password-store
#
# Debian-based systems' chromium wrapper script sources every file
# in /etc/chromium.d/ and appends whatever is in CHROMIUM_FLAGS to the
# real launch command - for ANY invocation, not just ones from our kiosk
# autostart script. This makes --password-store=basic apply even when
# Chromium is opened manually (e.g. from the taskbar/menu), so the login
# keyring prompt caused by desktop auto-login is suppressed everywhere,
# not just in the kiosk session.
CHROMIUM_FLAGS="$CHROMIUM_FLAGS --password-store=basic"
