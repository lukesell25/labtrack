#!/bin/sh
# ~/.config/labwc/autostart
#
# IMPORTANT: labwc invokes this file directly with `sh` (dash on Raspberry
# Pi OS), ignoring any shebang line. So everything below must be POSIX sh
# compatible - bash-only features (like /dev/tcp, used in an earlier
# version of this script) will silently fail under dash and hang forever,
# which is exactly what happened here once already. Stick to plain POSIX
# constructs and external tools (curl) rather than bash builtins.

# Wait for the LabTrack backend to actually be listening before launching
# the browser - on boot, the desktop session can come up before the
# labtrack systemd service has finished starting (especially over Wi-Fi,
# where association itself takes a few seconds), which would otherwise
# show a "connection refused" page instead of the kiosk display.
while ! curl -s -o /dev/null http://localhost:5000; do
  sleep 1
done

# --password-store=basic skips Chromium's OS-keyring integration for THIS
# launch. /etc/chromium.d/99-labtrack-password-store (installed alongside
# this file) applies the same flag to every launch of chromium, including
# manual ones from a menu - see that file for why both exist.
# Performance flags for the Pi 4's V3D GPU:
#   --enable-gpu-rasterization keeps rasterization on the GPU rather than the
#   CPU. Raspberry Pi OS already passes this from its own /etc/chromium.d/
#   drop-in, so it is belt-and-braces - it stays here so this launch doesn't
#   silently depend on a distro default that could change.
#   --disable-background-networking stops Chromium's periodic phone-home
#   fetches, which is pure wasted CPU on an appliance showing one local page.
#
# Chromium's stderr is piped into the journal under the tag
# labtrack-chromium (`journalctl -t labtrack-chromium`). Without this it
# goes to the labwc session's own output and is effectively unreadable,
# which matters because GPU and V4L2 decoder complaints surface there -
# including anything the hardware video decoder has to say when the
# background video misbehaves. `logger` is part of util-linux, always
# present. Note the pipeline as a whole is backgrounded by the trailing &.
#
#   Deliberately NOT passing --ignore-gpu-blocklist: a chrome://gpu dump from
#   this Pi (V3D 4.2.14.0, Mesa 26.2.0, Chrome 151) reports "Rasterization:
#   Hardware accelerated on all pages" WITHOUT that flag, so the blocklist
#   isn't vetoing anything here and overriding it would only risk artifacts.
#   To re-check after a Chromium or Mesa update, open chrome://gpu on the Pi:
#   Rasterization, Compositing, Canvas and Video Decode should all say
#   hardware accelerated.
chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --password-store=basic \
  --check-for-update-interval=31536000 \
  --ozone-platform=wayland \
  --enable-gpu-rasterization \
  --disable-background-networking \
  --disable-features=Translate \
  http://localhost:5000 2>&1 | logger -t labtrack-chromium &
