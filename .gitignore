venv
__pycache__
labtrack.db
# SQLite's write-ahead log and its index (journal_mode=WAL, database.py).
labtrack.db-wal
labtrack.db-shm

# Video sources and encode experiments stay out of git — they are large,
# they churn, and every version is permanent once committed. Only the
# deployed background is tracked; regenerate it per README step 7.
static/media/*.mp4
static/media/*.mov
static/media/*.mkv
static/media/*.webm
!static/media/background.mp4

# The roster hashing key from when members were identified by CAC. Nothing
# uses it any more - delete it - but keep it out of git if it's still around.
config/roster.key

# The shared password for viewing the dashboard from another PC. Generated
# on first run; per-Pi, so it never belongs in the repo.
config/dashboard.key

# Snapshots the old dashboard admin panel took before "clear all events".
# Nothing creates these any more, but they hold the old timestamped event log
# - delete any left on the Pi rather than letting them get committed.
labtrack-*.bak

# Hardware vs software video decode for the kiosk browser. Per-Pi and edited
# in place by scripts/set-decode.sh, so tracking it would make `git pull`
# fight with a local troubleshooting change. Absent means hardware.
config/decode-mode
