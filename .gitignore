venv
__pycache__
labtrack.db

# Video sources and encode experiments stay out of git — they are large,
# they churn, and every version is permanent once committed. Only the
# deployed background is tracked; regenerate it per README step 7.
static/media/*.mp4
static/media/*.mov
static/media/*.mkv
static/media/*.webm
!static/media/background.mp4

# The roster hashing key. Losing it means no card matches; leaking it
# alongside config/members.json is the one thing that weakens the hashes.
config/roster.key
