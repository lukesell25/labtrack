[Unit]
Description=LabTrack web app (timesheet + status board)
After=network.target pcscd.service
Wants=pcscd.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/labtrack
# The system directories are on here deliberately: a bare PATH of just the
# venv would make gunicorn work (it is launched by absolute path) while
# silently breaking any subprocess looked up by name - which is exactly how
# health.py's `vcgencmd get_throttled` probe came to report "?" for
# undervoltage. health.py now resolves it absolutely too, belt and braces.
Environment=PATH=/home/admin/labtrack/venv/bin:/usr/local/bin:/usr/bin:/bin
# Belt and braces so log lines reach journald promptly even if something
# upstream leaves stderr block-buffered - during a multi-day soak test a
# buffered final line is exactly the one you want after a crash.
Environment=PYTHONUNBUFFERED=1
# -w 1 is load-bearing, do NOT raise it: app.py starts the CAC monitor and
# holds the last-event state at import time, so a second worker would mean a
# second monitor fighting over the reader and a second copy of that state.
# --threads lets the one worker serve the kiosk's 1.5s poll without queueing
# behind a dashboard request from another PC (the sync worker is serial).
ExecStart=/home/admin/labtrack/venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5000 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
