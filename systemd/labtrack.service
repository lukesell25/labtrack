[Unit]
Description=LabTrack web app (timesheet + status board)
After=network.target pcscd.service
Wants=pcscd.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/labtrack
Environment=PATH=/home/admin/labtrack/venv/bin
# -w 1 is load-bearing, do NOT raise it: app.py starts the CAC monitor and
# holds the last-event state at import time, so a second worker would mean a
# second monitor fighting over the reader and a second copy of that state.
# --threads lets the one worker serve the kiosk's 1.5s poll without queueing
# behind a dashboard request from another PC (the sync worker is serial).
ExecStart=/home/admin/labtrack/venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5000 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
